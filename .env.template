# Copy this file to .env and replace the encryption key before the first boot.
#   copy .env.template .env
# .env is gitignored. Do not put cloud API keys in this project.

# Host clock for n8n schedules and logs. Match the workstation.
TZ=America/Bogota

# n8n editor. Compose publishes it on 127.0.0.1 only.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/

# Required. A long random string. Changing it later makes saved n8n credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# LM Studio local server. The desktop app stays on the host; it is not a Compose service.
# In LM Studio: load the model, start the server, and allow it to be reached on the local network
# so the n8n container can call host.docker.internal. Confirm the id with GET /v1/models.
# This workstation has liquid/lfm2.5-1.2b installed.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=liquid/lfm2.5-1.2b
LMSTUDIO_TIMEOUT_MS=120000

# Angular dev server. This is a host process (ng serve), not a Compose service yet.
# The app does not read this file. The value is the contract for the UI base URL.
ANGULAR_DEV_URL=http://localhost:4200
